<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="genba-auth-002-role" author="mihnea">
        <createTable tableName="role">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name_en" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="name_ro" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="system_managed" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="role">
            <column name="code" value="SUPER_ADMIN"/>
            <column name="name_en" value="Super Admin"/>
            <column name="name_ro" value="Super Admin"/>
            <column name="description" value="Cross-org system administrator (Layer 1+)"/>
            <column name="system_managed" valueBoolean="true"/>
        </insert>

        <insert tableName="role">
            <column name="code" value="OWNER"/>
            <column name="name_en" value="Owner"/>
            <column name="name_ro" value="Proprietar"/>
            <column name="description" value="Organization owner; full control within org"/>
            <column name="system_managed" valueBoolean="true"/>
        </insert>

        <insert tableName="role">
            <column name="code" value="ADMIN"/>
            <column name="name_en" value="Admin"/>
            <column name="name_ro" value="Administrator"/>
            <column name="description" value="Organization admin"/>
            <column name="system_managed" valueBoolean="true"/>
        </insert>

        <insert tableName="role">
            <column name="code" value="MEMBER"/>
            <column name="name_en" value="Member"/>
            <column name="name_ro" value="Membru"/>
            <column name="description" value="Standard organization member"/>
            <column name="system_managed" valueBoolean="true"/>
        </insert>

        <insert tableName="role">
            <column name="code" value="GUEST"/>
            <column name="name_en" value="Guest"/>
            <column name="name_ro" value="Invitat"/>
            <column name="description" value="External read+comment guest (Pro tier)"/>
            <column name="system_managed" valueBoolean="true"/>
        </insert>

        <rollback>
            <dropTable tableName="role"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
