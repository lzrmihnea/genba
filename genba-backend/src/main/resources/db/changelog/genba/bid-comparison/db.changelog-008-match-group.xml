<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="genba-cmp-008-match-group" author="mihnea">
        <createTable tableName="offer_line_match_group">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_match_group_project"
                             references="project(id)"/>
            </column>
            <column name="label" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID">
                <constraints foreignKeyName="fk_match_group_created_by" references="app_user(id)"/>
            </column>
        </createTable>

        <createIndex tableName="offer_line_match_group" indexName="idx_match_group_project">
            <column name="project_id"/>
        </createIndex>

        <createTable tableName="match_group_line">
            <column name="match_group_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_mgl_group"
                             references="offer_line_match_group(id)"
                             deleteCascade="true"/>
            </column>
            <!-- UNIQUE enforces one-group-per-line within the whole project. -->
            <column name="offer_line_id" type="UUID">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_mgl_offer_line"
                             foreignKeyName="fk_mgl_offer_line"
                             references="offer_line(id)"
                             deleteCascade="true"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="match_group_line"
                       columnNames="match_group_id, offer_line_id"
                       constraintName="pk_match_group_line"/>

        <rollback>
            <dropTable tableName="match_group_line"/>
            <dropTable tableName="offer_line_match_group"/>
        </rollback>
    </changeSet>

    <changeSet id="genba-cmp-009-dismissed-recommendation" author="mihnea">
        <createTable tableName="dismissed_recommendation">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dismissed_rec_project"
                             references="project(id)"/>
            </column>
            <column name="current_offer_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dismissed_rec_offer"
                             references="offer(id)"
                             deleteCascade="true"/>
            </column>
            <column name="source_line_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dismissed_rec_line"
                             references="offer_line(id)"
                             deleteCascade="true"/>
            </column>
            <column name="dismissed_by" type="UUID">
                <constraints foreignKeyName="fk_dismissed_rec_user" references="app_user(id)"/>
            </column>
            <column name="dismissed_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="dismissed_recommendation"
                             columnNames="current_offer_id, source_line_id"
                             constraintName="uq_dismissed_rec"/>

        <rollback>
            <dropTable tableName="dismissed_recommendation"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
